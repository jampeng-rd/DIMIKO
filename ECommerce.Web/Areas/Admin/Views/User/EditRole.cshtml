@using ECommerce.Models.ViewModels
@model UserRoleEditViewModel

@{
    ViewData["Title"] = "更新使用者";
}

<div class="container-fluid px-4">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 my-2">
        <i class="bi bi-arrow-left"></i> 返回使用者列表
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" 
             style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Update User</h5>
            <p class="mb-0 small" style="color: #1DB954;">編輯使用者角色</p>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-area="Admin" asp-controller="User" asp-action="EditRole">

                <input asp-for="UserId" type="hidden" />

                <div asp-validation-summary="ModelOnly"class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small"></label>
                    <input asp-for="Name" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small"></label>
                    <input asp-for="Email" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="SelectedRole" class="form-label fw-semibold small"></label>
                    <select asp-for="SelectedRole" asp-items="Model.RoleList" class="form-select">
                        <option value="">-- 請選擇角色 --</option>
                    </select>

                    <span asp-validation-for="SelectedRole" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">儲存角色</button>
                    <a asp-action="Index" class="btn btn-light fw-medium">取消</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
