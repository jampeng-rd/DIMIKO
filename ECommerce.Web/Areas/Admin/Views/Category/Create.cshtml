@using ECommerce.Models
@model Category

@{
    ViewData["Title"] = "Create Category";
}

<div class="container-fluid px-0">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 my-2">
        <i class="bi bi-arrow-left"></i> 返回類別列表
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #025A93, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Create Category</h5>
            <p class="mb-0 small" style="color: #0B9BFE;">新增類別</p>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-controller="Category" asp-action="Create">

                @* 測試顯示驗證錯誤摘要
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>  *@ 

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small"></label>
                    <input asp-for="Name" class="form-control" placeholder="請輸入分類名稱" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayOrder" class="form-label fw-semibold small"></label>
                    <input asp-for="DisplayOrder" class="form-control" placeholder="請輸入順序號碼" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">確認新增</button>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-light fw-medium">取消</a>
                </div>
            </form>
        </div>
    </div>
</div>

@* 使用者輸入錯誤時，可以在瀏覽器端先顯示訊息，不必每次都送到伺服器才知道。*@
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
