@using ECommerce.Models
@model Category

@{
    ViewData["Title"] = "Update Category";
}

<div class="container-fluid px-0">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 my-2">
        <i class="bi bi-arrow-left"></i> 返回類別列表
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header admin-card-header text-white py-3 px-4">
            <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Update Category</h5>
            <p class="admin-card-subtitle mb-0 small">更新類別</p>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-controller="Category" asp-action="Update">

                <input asp-for="Id" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small"></label>
                    <input asp-for="Name" class="form-control" placeholder="請輸入分類名稱" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayOrder" class="form-label fw-semibold small"></label>
                    <input asp-for="DisplayOrder" class="form-control" placeholder="請輸入順序號碼" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">確認更新</button>
                    <a asp-action="Index" class="btn btn-light fw-medium">取消</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
