@using ECommerce.Models
@model Category

@{
    ViewData["Title"] = "刪除商品類型";
}

<div class="container-fluid px-4">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 my-2">
        <i class="bi bi-arrow-left"></i> 返回類別列表
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header admin-card-header text-white py-3 px-4">
            <h5 class="mb-0 fw-bold"><i class="bi bi-trash me-2"></i>Delete Category</h5>
            <p class="admin-card-subtitle mb-0 small">此操作無法復原，請確認是否刪除此類別</p>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-controller="Category" asp-action="Delete">

                <input asp-for="Id" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small"></label>
                    @* <input asp-for="Name" class="form-control" placeholder="請輸入分類名稱" readonly /> *@
                    <div class="form-control bg-light">@Model.Name</div>
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayOrder" class="form-label fw-semibold small"></label>
                    @* <input asp-for="DisplayOrder" class="form-control" placeholder="請輸入順序號碼" readonly /> *@
                    <div class="form-control bg-light">@Model.DisplayOrder</div>
                </div>

                <div class="alert alert-warning">
                    確定要刪除「<strong>@Model.Name</strong>」嗎？
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-danger fw-semibold">確認刪除</button>
                    <a asp-action="Index" class="btn btn-light fw-medium">取消</a>
                </div>
            </form>
        </div>
    </div>
</div>
