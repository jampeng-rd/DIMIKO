@using ECommerce.Models.ViewModels
@model HeroBannerUpdateViewModel

@{
    ViewData["Title"] = "編輯輪播圖";
}

<div class="container-fluid px-4">

    <a asp-action="Index"
       class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 my-2">
        <i class="bi bi-arrow-left"></i> 返回輪播管理
    </a>

    <div class="card border-0 shadow-sm overflow-hidden">

        <div class="card-header admin-card-header text-white py-3 px-4">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-pencil-square me-2"></i>編輯首頁輪播
            </h5>
            <p class="admin-card-subtitle mb-0 small">
                修改輪播內容或更換圖片
            </p>
        </div>

        <div class="card-body p-4">

            <form asp-action="Update" method="post"
                  enctype="multipart/form-data">

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- 目前桌面版圖片 -->
                <div class="mb-4">
                    <label class="form-label fw-medium">
                        目前桌面版圖片
                    </label>

                    <div>
                        <img src="@Model.CurrentImageUrl"
                             alt="目前桌面版輪播圖片"
                             style="max-width: 520px; width: 100%; aspect-ratio: 17 / 9; object-fit: cover;
                                    border-radius: 0.5rem;" />
                    </div>
                </div>

                <!-- 更換桌面版圖片 -->
                <div class="mb-4">

                    <div class="d-flex">
                        <label asp-for="ImageFile" class="form-label fw-medium pe-2"></label>

                        <h6 class="badge text-bg-secondary">
                            建議 1700 × 900 px，不選則保留原圖
                        </h6>
                    </div>

                    <input asp-for="ImageFile" type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <hr class="my-4" />

                <!-- 目前手機版圖片 -->
                <div class="mb-4">
                    <label class="form-label fw-medium">目前手機版圖片</label>

                    @if (!string.IsNullOrWhiteSpace(Model.CurrentMobileImageUrl))
                    {
                        <div>
                            <img src="@Model.CurrentMobileImageUrl"
                                 alt="目前手機版輪播圖片"
                                 style="max-width: 260px; width: 100%; aspect-ratio: 2 / 3; object-fit: cover;
                                        border-radius: 0.5rem;" />
                        </div>
                    }
                    else
                    {
                        <div class="text-secondary small">
                            尚未設定手機版圖片，目前手機會使用桌面版圖片。
                        </div>
                    }
                </div>

                <!-- 更換手機版圖片 -->
                <div class="mb-4">
                    <div class="d-flex">
                        <label asp-for="MobileImageFile" class="form-label fw-medium pe-2"></label>

                        <h6 class="badge text-bg-secondary">
                            建議 1024 × 1536 px，不選則保留原圖
                        </h6>
                    </div>

                    <input asp-for="MobileImageFile" type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                    <span asp-validation-for="MobileImageFile" class="text-danger"></span>
                </div>


                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ButtonText" class="form-label"></label>
                        <input asp-for="ButtonText" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LinkUrl" class="form-label"></label>
                        <input asp-for="LinkUrl" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DisplayOrder" class="form-label"></label>
                        <input asp-for="DisplayOrder" type="number" min="0" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">儲存修改</button>
                    <a asp-action="Index" class="btn btn-light fw-medium">取消</a>
                </div>

            </form>

        </div>
    </div>
</div>
