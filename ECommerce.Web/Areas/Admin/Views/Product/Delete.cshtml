@using ECommerce.Models
@model Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container-fluid px-0">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 my-2">
        <i class="bi bi-arrow-left"></i> 返回商品列表
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #025A93, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-trash me-2"></i>Delete Product</h5>
            <p class="mb-0 small" style="color: #0B9BFE;">此操作無法復原，請確認是否刪除此商品</p>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-controller="Product" asp-action="Delete">

                <input asp-for="Id" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold small"></label>
                    <div class="form-control bg-light">@(Model?.Title ?? "未知商品")</div>
                </div>

                <div class="mb-3">
                    <label asp-for="SKU" class="form-label fw-semibold small"></label>
                    <div class="form-control bg-light">@(Model?.SKU ?? "無商品編號")</div>
                </div>

                <div class="mb-3">
                    <label asp-for="StockQuantity" class="form-label fw-semibold small"></label>
                    <div class="form-control bg-light">@(Model?.StockQuantity ?? 0)</div>
                </div>

                <div class="mb-3">
                    <label asp-for="IsActive" class="form-label fw-semibold small"></label>
                    <div class="form-control bg-light">@(Model?.IsActive == true ? "已上架" : "未上架")</div>
                </div>

                <div class="alert alert-warning">
                    確定要刪除「<strong>@(Model?.Title ?? "未知商品")</strong>」嗎？
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">確認刪除</button>
                    <a asp-action="Index" class="btn btn-light fw-medium">取消</a>
                </div>
            </form>
        </div>
    </div>
</div>
