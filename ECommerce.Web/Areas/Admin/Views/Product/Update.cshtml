@using ECommerce.Models.ViewModels
@model ProductUpdateViewModel

@{
    ViewData["Title"] = "Update Product";
}

<div class="container-fluid px-4">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 my-2">
        <i class="bi bi-arrow-left"></i> 返回商品列表
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header admin-card-header text-white py-3 px-4">
            <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Update Product</h5>
            <p class="admin-card-subtitle mb-0 small">更新商品</p>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-controller="Product" asp-action="Update" enctype="multipart/form-data">

                <input asp-for="Product.Id" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Product.Title" class="form-label fw-semibold small"></label>
                    <input asp-for="Product.Title" class="form-control" placeholder="請輸入商品名稱" />
                    <span asp-validation-for="Product.Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Product.Description" class="form-label fw-semibold small"></label>
                    <textarea asp-for="Product.Description" class="form-control" rows="5" placeholder="請輸入商品描述"></textarea>
                    <span asp-validation-for="Product.Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Product.SKU" class="form-label fw-semibold small"></label>
                    <input asp-for="Product.SKU" class="form-control" placeholder="請輸入商品編號" />
                    <span asp-validation-for="Product.SKU" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Product.ListPrice" class="form-label fw-semibold small"></label>
                    <input asp-for="Product.ListPrice" asp-format="{0:0.##}" type="number" class="form-control" min="0" max="99999" step="0.01" placeholder="請輸入原價" />
                    <span asp-validation-for="Product.ListPrice" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Product.Price" class="form-label fw-semibold small"></label>
                    <input asp-for="Product.Price" asp-format="{0:0.##}" type="number" class="form-control" min="0" max="99999" step="0.01" placeholder="請輸入售價" />
                    <span asp-validation-for="Product.Price" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Product.Price5" class="form-label fw-semibold small"></label>
                    <input asp-for="Product.Price5" asp-format="{0:0.##}" type="number" class="form-control" min="0" max="99999" step="0.01" placeholder="選填：請輸入 5 件以上價格" />
                    <span asp-validation-for="Product.Price5" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Product.Price10" class="form-label fw-semibold small"></label>
                    <input asp-for="Product.Price10" asp-format="{0:0.##}" type="number" class="form-control" min="0" max="99999" step="0.01" placeholder="選填：請輸入 10 件以上價格" />
                    <span asp-validation-for="Product.Price10" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Product.StockQuantity" class="form-label fw-semibold small"></label>
                    <input asp-for="Product.StockQuantity" type="number" class="form-control" min="0" step="1" placeholder="請輸入庫存數量" />
                    <span asp-validation-for="Product.StockQuantity" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Product.CategoryId" class="form-label fw-semibold small"></label>

                    <select asp-for="Product.CategoryId" asp-items="ViewBag.CategoryList" class="form-select">
                        <option value="">-- 請選擇商品分類 --</option>
                    </select>

                    <span asp-validation-for="Product.CategoryId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold small">現有商品圖片</label>

                    @if (Model.ExistingImages.Count == 0)
                    {
                        <div class="text-secondary small">
                            此商品目前沒有圖片。
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var image in Model.ExistingImages)
                            {
                                <div class="card p-2 product-image-card">

                                    <div class="position-relative">
                                        <img src="@image.ImageUrl" alt="商品圖片" class="img-thumbnail" product-existing-image/>

                                        @if (image.IsPrimary)
                                        {
                                            <span class="position-absolute top-0 start-0 badge bg-primary m-1">
                                                首圖
                                            </span>
                                        }
                                    </div>

                                    <div class="d-grid gap-2 mt-2">
                                        @if (!image.IsPrimary)
                                        {
                                            <button type="submit"
                                                    asp-action="SetPrimaryImage"
                                                    asp-route-imageId="@image.Id"
                                                    asp-route-productId="@Model.Product.Id"
                                                    class="btn btn-sm btn-outline-primary"
                                                    formnovalidate>
                                                設為首圖
                                            </button>
                                        }

                                        <button type="submit"
                                                asp-action="DeleteImage"
                                                asp-route-imageId="@image.Id"
                                                asp-route-productId="@Model.Product.Id"
                                                class="btn btn-sm btn-outline-danger"
                                                formnovalidate
                                                onclick="return confirm('確定要刪除這張圖片嗎？');">
                                            刪除圖片
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label asp-for="NewImages" class="form-label fw-semibold small"></label>

                    <input asp-for="NewImages"
                           type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp"
                           multiple />

                    <span asp-validation-for="NewImages" class="text-danger small"></span>

                    <div class="form-text">可以繼續加入多張圖片，單張圖片不可超過 5 MB。</div>
                    <div id="newImagePreviewContainer" class="d-flex flex-wrap gap-2 mt-3"></div>
                </div>

                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input asp-for="Product.IsActive" class="form-check-input" />
                        <label asp-for="Product.IsActive" class="form-check-label"></label>
                    </div>
                    <span asp-validation-for="Product.IsActive" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">確認更新</button>
                    <a asp-action="Index" class="btn btn-light fw-medium">取消</a>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const newImageInput = document.getElementById("NewImages");

        const newImagePreviewContainer = document.getElementById("newImagePreviewContainer");

        newImageInput.addEventListener("change", function (event) {
            newImagePreviewContainer.innerHTML = "";

            const files = Array.from(event.target.files);

            files.forEach(function (file, index) {
                if (!file.type.startsWith("image/")) {
                    return;
                }

                const previewUrl = URL.createObjectURL(file);

                const image = document.createElement("img");

                image.src = previewUrl;
                image.alt = `新增商品圖片 ${index + 1}`;
                image.className = "img-thumbnail product-image-preview";

                image.addEventListener("load",function () {
                    URL.revokeObjectURL(previewUrl);
                });

                newImagePreviewContainer.appendChild(image);
            });
        });
    </script>

}
