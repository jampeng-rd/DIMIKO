@model ProfileViewModel

@{
    ViewData["Title"] = "我的帳戶";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header admin-card-header text-white py-3 px-4">

                    <div class="d-flex align-items-center gap-3">
                        <div>
                            <i class="bi bi-person-circle fs-2"></i>
                        </div>

                        <div>
                            <h4 class="mb-1 fw-bold">
                                我的帳戶
                            </h4>

                            <p class="mb-0 small text-white-50">
                                查看與修改您的個人資料
                            </p>
                        </div>
                    </div>

                </div>


                <div class="card-body p-4">
                    <form method="post">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" />

                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />

                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" />

                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PostalCode" class="form-label"></label>
                                <input asp-for="PostalCode" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="City" class="form-label"></label>
                                <input asp-for="City" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="State" class="form-label"></label>
                                <input asp-for="State" class="form-control" />
                            </div>

                            <div class="col-12">
                                <label asp-for="StreetAddress" class="form-label"></label>
                                <input asp-for="StreetAddress" class="form-control" />
                            </div>

                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
                            <a asp-action="ChangePassword" class="btn btn-outline-secondary">

                                <i class="bi bi-shield-lock me-1"></i>
                                修改密碼

                            </a>

                            <button type="submit" class="btn btn-accent px-4">

                                <i class="bi bi-check-lg me-1"></i>
                                儲存變更

                            </button>
                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
