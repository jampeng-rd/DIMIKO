@model ECommerce.Models.OrderHeader

@{
    ViewData["Title"] = "訂單明細";

    var orderStatusText = Model.OrderStatus switch
    {
        "Pending" => "待處理",
        "Approved" => "已確認",
        "Processing" => "處理中",
        "Shipped" => "已出貨",
        "Cancelled" => "已取消",
        _ => Model.OrderStatus
    };

    var paymentStatusText = Model.PaymentStatus switch
    {
        "Pending" => "待付款",
        "Approved" => "已付款",
        "Rejected" => "付款失敗",
        "Refunded" => "已退款",
        _ => Model.PaymentStatus
    };
}

<div class="container py-4" style="max-width: 1140px;">

    <a asp-area="Customer" asp-controller="Order" asp-action="Index"
       class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i>
        返回我的訂單
    </a>

    <div class="row g-4 align-items-start">

        <div class="col-lg-8">

            <div class="card border shadow-sm overflow-hidden">

                <div class="card-header text-white px-4 py-3"
                     style="background: linear-gradient(to right, #065f46, #282828, #191414);">

                    <div class="d-flex justify-content-between align-items-center gap-3">

                        <div>
                            <small class="text-white-50">
                                訂單編號
                            </small>

                            <h5 class="fw-bold mb-0">
                                @Model.OrderNumber
                            </h5>
                        </div>

                        <span class="badge bg-warning text-dark">
                            @orderStatusText
                        </span>
                    </div>
                </div>

                <div class="card-body p-0">

                    @foreach (var detail in Model.OrderDetails)
                    {
                        var imageUrl = detail.Product.ProductImages
                            .OrderByDescending(image => image.IsPrimary)
                            .Select(image => image.ImageUrl)
                            .FirstOrDefault();

                        <div class="d-flex gap-3 px-4 py-3 border-bottom">

                            <div class="flex-shrink-0 rounded overflow-hidden bg-light"
                                 style="width: 76px; height: 76px;">

                                @if (!string.IsNullOrWhiteSpace(imageUrl))
                                {
                                    <img src="@imageUrl"
                                         alt="@detail.Product.Title"
                                         class="w-100 h-100"
                                         style="object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center text-secondary">
                                        <i class="bi bi-image fs-4"></i>
                                    </div>
                                }
                            </div>

                            <div class="flex-grow-1" style="min-width: 0;">

                                <a asp-area="Customer" asp-controller="Home" asp-action="Detail" asp-route-id="@detail.ProductId"
                                   class="fw-semibold text-decoration-none d-block text-truncate">
                                    @detail.Product.Title
                                </a>

                                <small class="text-secondary d-block mt-1">
                                    商品編號：@detail.Product.SKU
                                </small>

                                <small class="text-secondary">
                                    @detail.Price.ToString("C0")
                                    ×
                                    @detail.Count
                                </small>
                            </div>

                            <div class="fw-bold flex-shrink-0">
                                @((detail.Price * detail.Count).ToString("C0"))
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>

        <div class="col-lg-4">

            <div class="card border shadow-sm mb-4">

                <div class="card-header bg-white px-4 py-3">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-info-circle me-2 text-success"></i>
                        訂單資訊
                    </h6>
                </div>

                <div class="card-body px-4">

                    <div class="mb-3">
                        <div class="text-secondary small mb-1">
                            購買時間
                        </div>
                        <div class="fw-medium">
                            @(Model.OrderDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm"))
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-secondary">
                            訂單狀態
                        </span>

                        <span class="badge bg-warning text-dark">
                            @orderStatusText
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-secondary">
                            付款狀態
                        </span>

                        <span class="badge bg-secondary">
                            @paymentStatusText
                        </span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">訂單總額</span>
                        <span class="fw-bold fs-5 text-success">
                            @Model.OrderTotal.ToString("C0")
                        </span>
                    </div>
                </div>
            </div>

            <div class="card border shadow-sm">

                <div class="card-header bg-white px-4 py-3">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-truck me-2 text-success"></i>
                        收件資訊
                    </h6>
                </div>

                <div class="card-body px-4">

                    <p class="fw-semibold mb-1">
                        @Model.Name
                    </p>

                    <p class="text-secondary mb-1">
                        <i class="bi bi-telephone me-1"></i>
                        @Model.PhoneNumber
                    </p>

                    <p class="text-secondary mb-0 d-flex align-items-start gap-2">
                        <i class="bi bi-geo-alt mt-1"></i>

                        <span>
                            @Model.PostalCode<br />
                            @Model.City @Model.State<br />
                            @Model.StreetAddress
                        </span>
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>
