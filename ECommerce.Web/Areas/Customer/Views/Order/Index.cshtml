@using ECommerce.Utility
@model IEnumerable<ECommerce.Models.OrderHeader>

@{
    ViewData["Title"] = "我的訂單";

}

<div class="container py-4" style="max-width: 1140px;">

    <a asp-area="Customer" asp-controller="Home" asp-action="Index"
       class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i>
        返回首頁
    </a>

    <div class="card border shadow-sm overflow-hidden">

        <div class="card-header text-white d-flex align-items-center justify-content-between px-4 py-3"
             style="background: linear-gradient(to right, #065f46, #282828, #191414);">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-receipt-cutoff me-2"></i>
                我的訂單
            </h5>

            <span class="badge rounded-pill bg-white bg-opacity-25">
                @Model.Count()
            </span>
        </div>

        @if (!Model.Any())
        {
            <div class="card-body text-center py-5">

                <i class="bi bi-receipt display-3 text-secondary"></i>

                <h4 class="fw-bold mt-3">
                    尚無訂單
                </h4>

                <p class="text-secondary mb-4">
                    您目前還沒有建立任何訂單。
                </p>

                <a asp-area="Customer" asp-controller="Home" asp-action="Index"
                   class="btn btn-accent px-4">
                    <i class="bi bi-shop me-1"></i>
                    開始購物
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 text-nowrap" style="min-width: 210px;">訂單編號</th>
                            <th class="py-3 text-nowrap" style="min-width: 165px;">建立時間</th>
                            <th class="py-3 text-nowrap">訂單狀態</th>
                            <th class="py-3 text-nowrap">付款狀態</th>
                            <th class="py-3 text-end text-nowrap" style="min-width: 120px;">訂單總額</th>
                            <th class="px-4 py-3 text-end" style="width: 100px;"></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var order in Model)
                        {
                            var orderStatusText = order.OrderStatus switch
                            {
                                SD.OrderStatusPending => "待確認",
                                SD.OrderStatusApproved => "已確認",
                                SD.OrderStatusInProcess => "處理中",
                                SD.OrderStatusShipped => "已出貨",
                                SD.OrderStatusCancelled => "已取消",
                                _ => order.OrderStatus
                            };

                            var orderStatusBadgeClass = order.OrderStatus switch
                            {
                                SD.OrderStatusPending => "bg-warning text-dark",
                                SD.OrderStatusApproved => "bg-primary",
                                SD.OrderStatusInProcess => "bg-info text-dark",
                                SD.OrderStatusShipped => "bg-success",
                                SD.OrderStatusCancelled => "bg-danger",
                                _ => "bg-secondary"
                            };

                            var paymentStatusText = order.PaymentStatus switch
                            {
                                SD.PaymentStatusPending => "待付款",
                                SD.PaymentStatusApproved => "已付款",
                                SD.PaymentStatusRejected => "付款失敗",
                                SD.PaymentStatusRefunded => "已退款",
                                _ => order.PaymentStatus
                            };

                            var paymentStatusClass = order.PaymentStatus switch
                            {
                                SD.PaymentStatusPending => "bg-secondary",
                                SD.PaymentStatusApproved => "bg-success",
                                SD.PaymentStatusRejected => "bg-danger",
                                SD.PaymentStatusRefunded => "bg-info text-dark",
                                _ => "bg-secondary"
                            };

                            <tr>
                                <td class="px-4">
                                    <span class="fw-semibold text-success text-nowrap">
                                        @order.OrderNumber
                                    </span>
                                </td>

                                <td class="text-nowrap">
                                    @(order.OrderDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm"))
                                </td>

                                <td>
                                    <span class="badge @orderStatusBadgeClass">
                                        @orderStatusText
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @paymentStatusText
                                    </span>
                                </td>

                                <td class="text-end fw-semibold">
                                    @order.OrderTotal.ToString("C0")
                                </td>

                                <td class="px-4 text-end">
                                    <a asp-area="Customer" asp-controller="Order" asp-action="Details" asp-route-id="@order.Id"
                                       class="btn btn-outline-secondary btn-sm text-nowrap">
                                        <i class="bi bi-eye me-1"></i>
                                        查看
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
    </div>
</div>
