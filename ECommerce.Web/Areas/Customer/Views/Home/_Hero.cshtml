@using ECommerce.Models
@model List<HeroBanner>

@if (Model.Any())
{
    <section class="hero-carousel-section">
        <div id="heroCarousel"
             class="carousel slide carousel-fade"
             data-bs-ride="carousel"
             data-bs-interval="5000">

            @if (Model.Count > 1)
            {
                <div class="carousel-indicators">
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        <button type="button"
                                data-bs-target="#heroCarousel"
                                data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "")">
                        </button>
                    }
                </div>
            }

            <div class="carousel-inner">

                @for (var i = 0; i < Model.Count; i++)
                {
                    var banner = Model[i];

                    <div class="carousel-item @(i == 0 ? "active" : "")">

                        <img src="@banner.ImageUrl"
                             class="d-block w-100 hero-carousel-image"
                             alt="@banner.Title" />

                        @if (!string.IsNullOrWhiteSpace(banner.Title)
                            || !string.IsNullOrWhiteSpace(banner.Description))
                        {
                            <div class="hero-carousel-overlay"></div>

                            <div class="carousel-caption hero-carousel-caption">

                                @if (!string.IsNullOrWhiteSpace(banner.Title))
                                {
                                    <h2 class="display-4 fw-bold">
                                        @banner.Title
                                    </h2>
                                }

                                @if (!string.IsNullOrWhiteSpace(banner.Description))
                                {
                                    <p class="lead">
                                        @banner.Description
                                    </p>
                                }

                                @if (!string.IsNullOrWhiteSpace(banner.ButtonText)
                                    && !string.IsNullOrWhiteSpace(banner.LinkUrl))
                                {
                                    <a href="@banner.LinkUrl"
                                       class="btn btn-accent rounded-pill px-4">
                                        @banner.ButtonText
                                    </a>
                                }

                            </div>
                        }

                    </div>
                }

            </div>

            @if (Model.Count > 1)
            {
                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#heroCarousel"
                        data-bs-slide="prev">

                    <span class="carousel-control-prev-icon"></span>
                    <span class="visually-hidden">上一張</span>
                </button>

                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#heroCarousel"
                        data-bs-slide="next">

                    <span class="carousel-control-next-icon"></span>
                    <span class="visually-hidden">下一張</span>
                </button>
            }

        </div>
    </section>
}
