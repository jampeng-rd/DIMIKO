@using ECommerce.Models
@model List<Product>

@{
    ViewData["Title"] = "Home";
}

<!-- _Hero.cshtml Section -->
<partial name="_Hero" />

<!-- Catalog Section -->
<div class="container py-5" id="catalog">
    <div class="mb-4">
        <p class="text-uppercase small fw-semibold mb-2" style="color: #17A34A; letter-spacing: 0.15em;">
            Outdoor Essentials
        </p>

        <h2 class="fw-bold mb-1">精選露營用品</h2>

        <p class="text-secondary mb-0">
            探索適合各種戶外旅程的實用裝備
        </p>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-3 g-4">

        <!-- 商品卡片範例 -->
        @if (Model.Any())
        {
            @foreach (var product in Model)
            {
 
                <div class="col">
                    @{
                        var primaryImage = product.ProductImages.FirstOrDefault(image => image.IsPrimary)
                            ?? product.ProductImages.OrderBy(image => image.SortOrder).FirstOrDefault();
                    }

                    <div class="card h-100 border shadow-sm product-card">

                        <a asp-area="Customer" asp-controller="Home" asp-action="Detail" asp-route-id="@product.Id"
                           class="text-decoration-none">

                            <div style="aspect-ratio: 1/1; overflow: hidden;">
                                @if (primaryImage != null)
                                {
                                    <img src="@primaryImage.ImageUrl"
                                         alt="@product.Title"
                                         class="w-100 h-100"
                                         style="object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light">
                                        <i class="bi bi-image display-3 text-secondary"></i>
                                    </div>
                                }
                            </div>
                        </a>

                        <div class="card-body d-flex flex-column">
                            
                            <span class="badge align-self-start mb-2" style="background: rgba(23,163,74,0.1); color: #17A34A;">
                                @(product.Category?.Name ?? "未分類")
                            </span>

                            <h6 class="card-title fw-semibold mb-2" style="min-height: 2.5rem;">
                                <a asp-area="Customer" asp-controller="Home" asp-action="Detail" asp-route-id="@product.Id"
                                   class="text-decoration-none text-dark">
                                    @product.Title
                                </a>
                            </h6>

                            <p class="text-secondary small mb-3">
                                @product.Description
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <div>
                                    <span class="fw-bold text-success">
                                        @product.Price.ToString("C0")
                                    </span>

                                    @if (product.ListPrice > product.Price)
                                    {
                                        <small class="text-decoration-line-through text-muted ms-1">
                                            @product.ListPrice.ToString("C0")
                                        </small>
                                    }
                                </div>

                                <a asp-area="Customer" asp-controller="Home" asp-action="Detail" asp-route-id="@product.Id"
                                   class="btn btn-sm btn-outline-dark">
                                    查看商品
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="text-center py-5 bg-light rounded">
                    <i class="bi bi-box-seam display-4 text-secondary"></i>
                    <p class="text-secondary mt-3 mb-0">
                        目前沒有可顯示的商品
                    </p>
                </div>
            </div>
        }

    </div>
</div>

<!-- _Newsletter.cshtml Section -->
<partial name="_Newsletter" />
