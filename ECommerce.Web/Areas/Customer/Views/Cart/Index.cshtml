@using ECommerce.Models.ViewModels
@model ShoppingCartViewModel

@{
    ViewData["Title"] = "購物清單";
}

<div class="container py-4" style="max-width: 1140px;">

    <a asp-area="Customer" asp-controller="Home" asp-action="Index"
        class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> 繼續購物
    </a>

    @if (!Model.CartItems.Any())
    {
        <div class="card border shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-cart-x display-3 text-secondary"></i>

                <h4 class="fw-bold mt-3">
                    你的購物車是空的
                </h4>

                <p class="text-secondary mb-4">
                    尚未將任何商品加入購物車。
                </p>

                <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-accent px-4">
                    <i class="bi bi-shop me-1"></i>
                    開始購物
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 align-items-start">

            <!-- 左側：購物車商品 -->
            <div class="col-lg-7">
                <div class="card border shadow-sm overflow-hidden">

                    <div class="card-header text-white d-flex align-items-center justify-content-between py-3 px-4"
                         style="background: linear-gradient(to right, #065f46, #282828, #191414);">

                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-bag me-2"></i>
                            購物車資訊
                        </h5>

                        <span class="badge rounded-pill bg-white bg-opacity-25 text-white">
                            @Model.TotalCount
                        </span>
                    </div>

                    <div class="cart-items-scroll">

                        @foreach (var item in Model.CartItems)
                        {
                            var imageUrl = item.Product.ProductImages
                                .OrderByDescending(image => image.IsPrimary)
                                .Select(image => image.ImageUrl)
                                .FirstOrDefault();

                            <div class="d-flex gap-3 px-4 py-3 border-bottom cart-item">

                                <!-- 商品圖片 -->
                                <a asp-area="Customer" asp-controller="Home" asp-action="Detail" asp-route-id="@item.ProductId"
                                   class="flex-shrink-0">

                                    <div class="rounded overflow-hidden bg-light"
                                         style="width: 72px; height: 82px;">

                                        @if (!string.IsNullOrWhiteSpace(imageUrl))
                                        {
                                            <img src="@imageUrl"
                                                 class="w-100 h-100"
                                                 style="object-fit: cover;"
                                                 alt="@item.Product.Title" />
                                        }
                                        else
                                        {
                                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-secondary">
                                                <i class="bi bi-image fs-4"></i>
                                            </div>
                                        }
                                    </div>
                                </a>

                                <!-- 商品資訊 -->
                                <div class="flex-grow-1" style="min-width: 0;">

                                    <a asp-area="Customer" asp-controller="Home" asp-action="Detail" asp-route-id="@item.ProductId"
                                       class="fw-semibold text-decoration-none d-block text-truncate" style="font-size: 0.9rem;">
                                        @item.Product.Title
                                    </a>

                                    <p class="text-secondary mb-2" style="font-size: 0.75rem;">
                                        @* 單價：@item.Price.ToString("C0") *@
                                        單價：NT$@item.Price.ToString("N0")
                                    </p>

                                    <div class="d-flex align-items-center gap-2">

                                        <!-- 減少 -->
                                        <form method="post" asp-action="Decrease" class="d-inline">
                                            <input type="hidden" name="cartId" value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-outline-secondary btn-sm"
                                                    aria-label="減少商品數量">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                        </form>

                                        <!-- 直接輸入數量 -->
                                        <form method="post" asp-action="UpdateQuantity"
                                              class="cart-quantity-form d-flex align-items-center">

                                            <input type="hidden" name="cartId" value="@item.Id" />

                                            <input type="number" name="count"
                                                   value="@item.Count"
                                                   min="1"
                                                   max="@Math.Min(1000, item.Product.StockQuantity)"
                                                   data-current-count="@item.Count"
                                                   data-stock="@item.Product.StockQuantity"
                                                   class="cart-quantity-input form-control form-control-sm text-center fw-bold"
                                                   style="width: 70px;" 
                                                   aria-label="@item.Product.Title 的購買數量" />
                                        </form>

                                        <!-- 增加 -->
                                        <form method="post" asp-action="Increase" class="d-inline">

                                            <input type="hidden" name="cartId" value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-outline-secondary btn-sm"
                                                    aria-label="增加商品數量"
                                                    disabled="@(item.Count >= item.Product.StockQuantity)">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        </form>
                                    </div>

                                    <small class="text-secondary d-block mt-2">
                                        庫存：@item.Product.StockQuantity
                                    </small>
                                </div>

                                <!-- 小計與刪除 -->
                                <div class="text-end flex-shrink-0 d-flex flex-column justify-content-between align-self-stretch">

                                    <span class="fw-bold" style="font-size: 0.95rem;">
                                        @* @((item.Price * item.Count).ToString("C0")) *@
                                        NT$@((item.Price * item.Count).ToString("N0"))
                                    </span>

                                    <form method="post" asp-action="Remove">

                                        <input type="hidden" name="cartId" value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-link text-danger text-decoration-none p-0"
                                                style="font-size: 0.75rem;"
                                                onclick="return confirm('確定要將此商品從購物車移除嗎？');">
                                            <i class="bi bi-trash3"></i>
                                            刪除
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="card-footer bg-white d-flex justify-content-end p-3">

                        <form method="post" asp-action="Clear">

                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                    onclick="return confirm('確定要清空購物車嗎？');">
                                <i class="bi bi-trash3 me-1"></i>
                                清空
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- 右側：訂單摘要 -->
            <div class="col-lg-5">
                <div class="position-lg-sticky" style="top: 80px;">

                    <div class="card border shadow-sm overflow-hidden">

                        <div class="px-4 py-3">
                            <h6 class="fw-bold mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-receipt" style="color: #17A34A;"></i>
                                訂單資訊
                            </h6>

                            @foreach (var item in Model.CartItems)
                            {
                                <div class="d-flex justify-content-between mb-2" style="font-size: 0.8rem;">

                                    <span class="text-secondary text-truncate me-2">
                                        @item.Product.Title × @item.Count
                                    </span>

                                    <span class="fw-medium flex-shrink-0">
                                        @* @((item.Price * item.Count).ToString("C0")) *@
                                        NT$@((item.Price * item.Count).ToString("N0"))
                                    </span>
                                </div>
                            }

                            <hr class="my-3" />

                            <div class="d-flex justify-content-between mb-2" style="font-size: 0.85rem;">
                                <span class="text-secondary">
                                    商品數量
                                </span>

                                <span class="fw-semibold">
                                    @Model.TotalCount
                                </span>
                            </div>

                            <div class="d-flex justify-content-between"
                                 style="font-size: 0.85rem;">
                                <span class="text-secondary">
                                    運費
                                </span>

                                <span class="fw-semibold" style="color: #17A34A;">
                                    免費
                                </span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center px-4 py-3 text-white"
                             style="background: linear-gradient(to right, #065f46, #282828, #191414);">

                            <span class="text-uppercase fw-semibold small">
                                Total
                            </span>

                            <span class="fw-bold fs-5">
                                @* @Model.OrderTotal.ToString("C0") *@
                                NT$@Model.OrderTotal.ToString("N0")
                            </span>
                        </div>

                        <div class="p-4">
                            <a asp-area="Customer" asp-controller="Cart" asp-action="Summary"
                               class="btn btn-accent w-100 fw-semibold py-2 d-flex align-items-center justify-content-center gap-2">
                                
                               <i class="bi bi-lock"></i>
                                前往結帳
                            </a>

                            <div class="d-flex justify-content-center gap-3 mt-3 text-secondary"
                                 style="font-size: 0.7rem;">
                                <span>
                                    <i class="bi bi-shield-check me-1"></i>
                                    Secure
                                </span>

                                <span>
                                    <i class="bi bi-truck me-1"></i>
                                    Free Shipping
                                </span>

                                <span>
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                    Returns
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelectorAll(".cart-quantity-input").forEach(input => {
            input.addEventListener("change", function() {
                const form = this.closest(".cart-quantity-form");
                const stock = Number(this.dataset.stock);
                const currentCount = Number(this.dataset.currentCount);
                const newCount = Number(this.value);

                this.setCustomValidity("");

                if (!Number.isInteger(newCount) || newCount < 1) {
                    this.setCustomValidity("商品數量至少必須為 1 件");
                    this.reportValidity();
                    this.value = currentCount;
                    return;
                }

                if (newCount > stock) {
                    this.setCustomValidity(`目前庫存僅剩 ${stock} 件`);
                    this.reportValidity();
                    this.value = currentCount;
                    return;
                }

                if (newCount === currentCount) {
                    return;
                }

                // readonly 仍會將 count 傳送到 Controller
                this.readOnly = true;

                form.submit();
            });

            input.addEventListener("input", function() {
                this.setCustomValidity("");
            });
        });
    </script>
}
