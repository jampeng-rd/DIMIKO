@model ECommerce.Models.ViewModels.ShoppingCartViewModel

@{
    ViewData["Title"] = "填寫訂單資訊";
}

<div class="container py-4" style="max-width: 1140px;">

    <a asp-area="Customer" asp-controller="Cart" asp-action="Index"
       class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">

        <i class="bi bi-arrow-left"></i>
        返回購物車
    </a>

    <form method="post" asp-area="Customer" asp-controller="Cart" asp-action="Summary">

        <div class="row g-4 align-items-start">

            <!-- 左側：收件資料 -->
            <div class="col-lg-7">

                <div class="card border shadow-sm overflow-hidden">

                    <div class="card-header text-white py-3 px-4"
                         style="background: linear-gradient(to right, #065f46, #282828, #191414);">

                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-truck me-2"></i>
                            收件資訊
                        </h5>
                    </div>

                    <div class="card-body p-4">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="OrderHeader.Name" class="form-label fw-semibold"></label>
                            <input asp-for="OrderHeader.Name" class="form-control" placeholder="請輸入收件人姓名" />

                            <span asp-validation-for="OrderHeader.Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OrderHeader.PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="OrderHeader.PhoneNumber" type="tel"
                                   inputmode="tel" autocomplete="tel" class="form-control"
                                   placeholder="例如：0912-345-678 或 02-12345678" />

                            <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="OrderHeader.City" class="form-label fw-semibold"></label>
                                <input asp-for="OrderHeader.City" class="form-control" placeholder="例如：台北市" />

                                <span asp-validation-for="OrderHeader.City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="OrderHeader.State" class="form-label fw-semibold"></label>
                                <input asp-for="OrderHeader.State" class="form-control" placeholder="例如：信義區" />

                                <span asp-validation-for="OrderHeader.State" class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="mt-3">
                            <label asp-for="OrderHeader.StreetAddress" class="form-label fw-semibold"></label>
                            <input asp-for="OrderHeader.StreetAddress" class="form-control" placeholder="請輸入詳細地址" />

                            <span asp-validation-for="OrderHeader.StreetAddress" class="text-danger small"></span>
                        </div>

                        <div class="mt-3">
                            <label asp-for="OrderHeader.PostalCode" class="form-label fw-semibold"></label>
                            <input asp-for="OrderHeader.PostalCode" class="form-control" placeholder="請輸入郵遞區號" />

                            <span asp-validation-for="OrderHeader.PostalCode" class="text-danger small"></span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- 右側：訂單摘要 -->
            <div class="col-lg-5">

                <div class="position-lg-sticky" style="top: 80px;">

                    <div class="card border shadow-sm overflow-hidden">

                        <div class="px-4 py-3 border-bottom">

                            <h6 class="fw-bold mb-0">
                                <i class="bi bi-receipt me-2 text-success"></i>
                                訂單摘要
                            </h6>
                        </div>

                        <div class="card-body px-4 py-3">

                            @foreach (var item in Model.CartItems)
                            {
                                var imageUrl = item.Product.ProductImages
                                    .OrderByDescending(image => image.IsPrimary)
                                    .Select(image => image.ImageUrl)
                                    .FirstOrDefault();

                                <div class="d-flex gap-3 py-3 border-bottom">

                                    <div class="flex-shrink-0 rounded overflow-hidden bg-light"
                                         style="width: 60px; height: 60px;">

                                        @if (!string.IsNullOrWhiteSpace(imageUrl))
                                        {
                                            <img src="@imageUrl"
                                                 alt="@item.Product.Title"
                                                 class="w-100 h-100"
                                                 style="object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-secondary">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                    </div>

                                    <div class="flex-grow-1"
                                         style="min-width: 0;">

                                        <div class="fw-semibold text-truncate">
                                            @item.Product.Title
                                        </div>

                                        <small class="text-secondary">
                                            @item.Price.ToString("C0")
                                            ×
                                            @item.Count
                                        </small>
                                    </div>

                                    <div class="fw-semibold flex-shrink-0">
                                        @((item.Price * item.Count).ToString("C0"))
                                    </div>
                                </div>
                            }

                            <div class="d-flex justify-content-between mt-3 mb-2">
                                <span class="text-secondary">
                                    商品總數
                                </span>

                                <span class="fw-semibold">
                                    @Model.TotalCount
                                </span>
                            </div>

                            <div class="d-flex justify-content-between">
                                <span class="text-secondary">
                                    運費
                                </span>

                                <span class="fw-semibold" style="color: #17A34A;">
                                    免費
                                </span>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between align-items-center px-4 py-3 text-white"
                             style="background: linear-gradient(to right, #065f46, #282828, #191414);">

                            <span class="fw-semibold">
                                訂單總額
                            </span>

                            <span class="fw-bold fs-5">
                                @Model.OrderTotal.ToString("C0")
                            </span>
                        </div>

                        <div class="card-footer bg-white p-4">

                            <button type="submit" class="btn btn-accent w-100 fw-semibold py-2">
                                <i class="bi bi-check-circle me-1"></i>
                                確認建立訂單
                            </button>


                        </div>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
