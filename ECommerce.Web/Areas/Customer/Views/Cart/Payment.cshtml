@using ECommerce.Models.Payments
@model NewebPayPaymentRequest

@{
    ViewData["Title"] = "前往付款";
}

@* 這是一個「自動 POST 頁」 *@
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">

            <div class="card shadow-sm border-0">
                <div class="card-body py-5">

                    <div class="spinner-border mb-3" role="status">
                        <span class="visually-hidden">
                            Loading...
                        </span>
                    </div>

                    <h4 class="fw-bold">
                        正在前往藍新金流
                    </h4>

                    <p class="text-secondary mb-0">
                        請稍候，正在建立安全付款連線...
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

<form id="newebPayForm" method="post" action="@Model.PaymentUrl">

    <input type="hidden" name="MerchantID" value="@Model.MerchantId" />
    <input type="hidden" name="TradeInfo" value="@Model.TradeInfo" />
    <input type="hidden" name="TradeSha" value="@Model.TradeSha" />
    <input type="hidden" name="Version" value="@Model.Version" />
</form>


@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            document.getElementById("newebPayForm").submit();
        });
    </script>
}
