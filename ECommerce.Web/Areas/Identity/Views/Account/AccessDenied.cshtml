@{
    ViewData["Title"] = "拒絕存取";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border overflow-hidden">
                <div class="card-header text-white py-3 px-4 text-center" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
                    <i class="bi bi-exclamation-triangle-fill display-4"></i>
                    <h4 class="fw-bold mt-2 mb-1">Access Denied</h4>
                    <p class="mb-0 small" style="color: #1DB954;">無法存取此頁面</p>
                </div>

                <div class="card-body p-5 text-center">
                    <p class="text-secondary mb-4">
                        您目前的帳號沒有使用此功能的權限。
                    </p>

                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-accent">
                        <i class="bi bi-house me-2"></i>返回首頁
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>


