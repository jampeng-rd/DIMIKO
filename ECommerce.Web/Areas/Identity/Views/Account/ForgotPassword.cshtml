@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "忘記密碼";
}

<div class="container">

    <div class="row justify-content-center my-5">

        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm border overflow-hidden">

                <div class="card-header text-white py-3 px-4 text-center"
                     style="background: linear-gradient(to right, #065f46, #282828, #191414);">

                    <i class="bi bi-key display-4"></i>

                    <h4 class="fw-bold mt-2 mb-1">
                        忘記密碼
                    </h4>

                    <p class="small text-white-50 mb-0">
                        輸入您的電子郵件，我們將寄送密碼重設連結
                    </p>

                </div>


                <div class="card-body p-4">

                    <form method="post">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />

                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-accent w-100">
                            <i class="bi bi-envelope me-1"></i>
                            寄送重設連結
                        </button>

                        <div class="text-center mt-3">

                            <a asp-action="Login" class="text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i>
                                返回登入
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
