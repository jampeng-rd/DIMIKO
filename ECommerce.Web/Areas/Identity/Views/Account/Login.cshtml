@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container">
    <div class="row justify-content-center my-4">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border overflow-hidden">
                <div class="card-header text-white py-3 px-4 text-center" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
                    <div class="w-100 d-flex align-items-center justify-content-center">
                        <i class="bi bi-box-arrow-in-right display-4 me-2" style="font-size:2rem;"></i>
                        <h4 class="fw-bold mt-2 mb-1">登入帳號</h4>
                    </div>
                    <p class="mb-0 small" style="color: #1DB954;">Log in to your account</p>
                </div>

                <div class="card-body p-5">
                    <form method="post" asp-area="Identity" asp-controller="Account" asp-action="Login"
                          asp-route-returnUrl="@ViewData["ReturnUrl"]">
                        
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control form-control" placeholder="name@example.com" />

                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control form-control" placeholder="請輸入密碼" />

                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>

                        <button type="submit" class="btn btn-accent btn w-100 mb-3">
                            <i class="bi bi-box-arrow-in-right me-2"></i>登入
                        </button>

                        <div class="text-center">
                            <a href="#" class="text-decoration-none">忘記密碼？</a>
                        </div>
                    </form>

                    <hr class="my-4" />

                    <div class="text-center">
                        <p class="mb-0">
                            尚未註冊帳號？
                            <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" 
                                class="fw-semibold text-decoration-none" style="color: #17A34A;">
                                立即註冊
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
