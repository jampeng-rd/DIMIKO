@model ResetPasswordViewModel

@{
    ViewData["Title"] = "重設密碼";
}

<div class="container">

    <div class="row justify-content-center my-5">

        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm border">

                <div class="card-header admin-card-header text-white text-center py-3">
                    <i class="bi bi-shield-lock display-5"></i>
                    <h4 class="fw-bold mt-2">
                        重設密碼
                    </h4>
                </div>

                <div class="card-body p-4">
                    <form method="post">

                        <input asp-for="Token" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />

                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>


                        <button type="submit" class="btn btn-accent w-100">
                            重設密碼
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
