@using ECommerce.Utility

@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

﻿<div class="admin-sidebar-nav">

    <p class="nav-section mb-1">Overview</p>

    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" 
       class="nav-link d-flex align-items-center gap-2
       @(currentArea == "Admin" && currentController == "Dashboard" ? "active" : "")">

        <i class="bi bi-graph-up"></i> Dashboard
    </a>

    @if (User.IsInRole(SD.RoleAdmin) || User.IsInRole(SD.RoleEmployee))
    {
        <p class="nav-section mb-1">Commerce</p>

        <a asp-area="Admin" asp-controller="Order" asp-action="Index" 
           class="nav-link d-flex align-items-center gap-2
           @(currentArea == "Admin" && currentController == "Order" ? "active" : "")">
            @* <i class="bi bi-truck"></i> *@
            <i class="bi bi-receipt-cutoff"></i>訂單管理
        </a>
        <a asp-area="Admin" asp-controller="Product" asp-action="Index" 
           class="nav-link d-flex align-items-center gap-2
           @(currentArea == "Admin" && currentController == "Product" ? "active" : "")">
            <i class="bi bi-book"></i> 商品管理
        </a>
        <a asp-area="Admin" asp-controller="Category" asp-action="Index" 
           class="nav-link d-flex align-items-center gap-2
           @(currentArea == "Admin" && currentController == "Category" ? "active" : "")">
            <i class="bi bi-tags"></i> 類別管理
        </a>


        <!-- 首頁輪播圖 -->
        <p class="nav-section mb-1">Website</p>

        <a asp-area="Admin" asp-controller="HeroBanner" asp-action="Index"
           class="nav-link d-flex align-items-center gap-2
            @(currentArea == "Admin" && currentController == "HeroBanner" ? "active" : "")">

            <i class="bi bi-images"></i>
            輪播圖設定
        </a>


        @if (User.IsInRole(SD.RoleAdmin))
        {
            <p class="nav-section mb-1">Management</p>
            <a asp-area="Admin" asp-controller="User" asp-action="Index" 
               class="nav-link d-flex align-items-center gap-2
               @(currentArea == "Admin" && currentController == "User" ? "active" : "")">
                <i class="bi bi-people"></i> 使用者管理
            </a>
        }
    }
    
</div>