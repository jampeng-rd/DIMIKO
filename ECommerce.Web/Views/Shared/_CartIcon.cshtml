@using ECommerce.Utility

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var cartCount = isAuthenticated
        ? Context.Session.GetInt32(SD.SessionCart) ?? 0
        : 0;
}

<a asp-area="Customer" asp-controller="Cart" asp-action="Index"
   class="navbar-cart" aria-label="購物車" title="購物車">

    <i class="bi bi-cart2"></i>

    @if (isAuthenticated && cartCount > 0)
    {
        <span class="navbar-cart-count">
            @(cartCount > 99 ? "99+" : cartCount)
        </span>
    }
</a>