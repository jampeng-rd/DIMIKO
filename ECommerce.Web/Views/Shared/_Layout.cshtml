@using ECommerce.Utility

@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DIMIKO - @ViewData["Title"]</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ECommerce.Web.styles.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100" style="background-color:#f5f5f5">
 
    <header class="site-header">
        <nav class="site-navbar">

            <div class="site-navbar-container">
                <!-- 左側：漢堡選單 -->
                <div class="site-navbar-left">
                    <button type="button" class="site-menu-toggle" id="siteMenuToggle"
                            aria-label="開啟導航選單"
                            aria-controls="siteDrawer"
                            aria-expanded="false">
                        <i class="bi bi-list"></i>
                    </button>
                </div>

                <!-- 中間：Logo + DIMIKO -->
                <div class="site-navbar-center">
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="site-brand">
                        <img src="/images/dimiko.png" class="site-brand-logo" alt="DIMIKO" />

                        <span class="site-brand-name">DIMIKO</span>
                    </a>
                </div>

                <!-- 右側：購物車 / 使用者 / 登入登出 -->
                <div class="site-navbar-right">

                    <partial name="_CartIcon" />

                    <partial name="_LoginPartial" />
                </div>
            </div>

        </nav>
    </header>


    <!-- =========================================
    左側滑出導航選單
    ========================================= -->
    <div class="site-drawer-overlay"id="siteDrawerOverlay"></div>

    <aside class="site-drawer" id="siteDrawer" aria-hidden="true">

        <div class="site-drawer-header">
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="site-drawer-brand">
                <img src="/images/dimiko.png" alt="DIMIKO" />

                <span >DIMIKO</span>
            </a>

            <button type="button" class="site-drawer-close" id="siteDrawerClose" aria-label="關閉導航選單">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <nav class="site-drawer-nav">

            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="site-drawer-link
                @(currentArea == "Customer" && currentController == "Home" && currentAction == "Index" ? "active" : "")">

                <span class="site-drawer-link-icon">
                    <i class="bi bi-house"></i>
                </span>

                <span>Home</span>
            </a>

            <a asp-area="Customer" asp-controller="Home" asp-action="Products" class="site-drawer-link
                @(currentArea == "Customer" && currentController == "Home" && currentAction == "Products" ? "active" : "")">

                <span class="site-drawer-link-icon">
                    <i class="bi bi-grid"></i>
                </span>

                <span>所有商品</span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-area="Customer" asp-controller="Order" asp-action="Index" class="site-drawer-link
                    @(currentArea == "Customer" && currentController == "Order" ? "active" : "")">

                    <span class="site-drawer-link-icon">
                        <i class="bi bi-receipt"></i>
                    </span>

                    <span>我的訂單</span>
                </a>
            }

            @if (User.IsInRole(SD.RoleAdmin) || User.IsInRole(SD.RoleEmployee))
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="site-drawer-link
                    @(currentArea == "Admin" ? "active" : "")">

                    <span class="site-drawer-link-icon">
                        <i class="bi bi-speedometer2"></i>
                    </span>

                    <span>後台系統</span>
                </a>
            }
        </nav>

    </aside>


    <div class="">
        <main role="main">

            <partial name="_Notification" />
            @RenderBody()

        </main>
    </div>


    <footer class="mt-auto py-3" style="background: #0D0D0D;">
        <div class="container">
            <div class="row align-items-center gy-3">
                
                <div class="col-sm-12 text-center">
                    <p class="mb-0 text-secondary small">&copy; @DateTime.Now.Year DIMIKO. All Rights Reserved.</p>
                </div>

            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const menuToggle = document.getElementById("siteMenuToggle");
            const drawer = document.getElementById("siteDrawer");
            const drawerClose = document.getElementById("siteDrawerClose");
            const drawerOverlay = document.getElementById("siteDrawerOverlay");
            const drawerLinks = document.querySelectorAll(".site-drawer-link");

            function openDrawer() {
                drawer.classList.add("open");
                drawerOverlay.classList.add("open");

                document.body.classList.add("drawer-open");

                drawer.setAttribute("aria-hidden", "false");
                menuToggle.setAttribute("aria-expanded", "true");
            }


            function closeDrawer() {
                drawer.classList.remove("open");
                drawerOverlay.classList.remove("open");

                document.body.classList.remove("drawer-open");

                drawer.setAttribute("aria-hidden", "true");
                menuToggle.setAttribute("aria-expanded", "false");
            }


            menuToggle.addEventListener("click", openDrawer);

            drawerClose.addEventListener("click", closeDrawer);

            drawerOverlay.addEventListener("click", closeDrawer);


            drawerLinks.forEach(function (link) {
                link.addEventListener("click", closeDrawer);
            });


            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    closeDrawer();
                }
            });

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


