@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <!-- 顯示使用者登入帳號 (Email) -->
    <!-- <a class="text-white-50 text-decoration-none small fw-medium">
        <i class="bi bi-person-circle me-1"></i> @UserManager.GetUserName(User)
    </a>  -->

    <a href="#" class="navbar-user" aria-label="使用者資料" title="使用者資料">
        <i class="bi bi-person"></i>
    </a>

    <form method="post" asp-area="Identity" asp-controller="Account" asp-action="Logout" class="navbar-auth-form">
        <button type="submit" class="navbar-auth-button">
            登出
        </button>
    </form>
}
else
{
    <!-- <a class="text-white-50 text-decoration-none small fw-medium nav-link-hover" asp-area="Identity"
       asp-controller="account" asp-action="Register">註冊
   </a> -->

    <a asp-area="Identity" asp-controller="Account" asp-action="Login" 
       class="navbar-auth-button navbar-login-button">
        登入
    </a>
}
